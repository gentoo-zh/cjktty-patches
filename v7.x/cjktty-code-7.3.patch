+#endif
 
 	return 0;
 
 err_kfree:
+#ifdef CONFIG_FONT_CJK
+	kvfree(par->rotated.buf);
+	par->rotated.fontdata = NULL;
+#else
 	kfree(par->rotated.buf);
+#endif
 	par->rotated.buf = NULL; /* clear here to avoid output */
 	par->rotated.bufsize = 0;
 
