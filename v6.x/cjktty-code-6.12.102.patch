+#ifdef CONFIG_FONT_CJK
+static u16 utf8_pos(struct vc_data *vc, const u16 *s)
+{
+	unsigned long p = (unsigned long) s;
+
+	if (p >= vc->vc_origin && p < vc->vc_scr_end)
+		return scr_readw((u16 *)((u8 *)vc->vc_screenbuf +
+			vc->vc_screenbuf_size + p - vc->vc_origin));
+	else
+		return scr_readw(s + 1);
+}
+
+u8 *font_bits(struct vc_data *vc, const u16 *s, u32 cellsize, u16 charmask,
+	struct fbcon_par *par)
+{
+	u8 *src;
+	u16 c_utf;
+	u16 ch = scr_readw(s) & charmask;
+	u32 cellsize_utf = (cellsize < 64) ? 16 : 64;
+	size_t offset;
+	void *fontdata;
+	char *fontname = (cellsize < 64) ? "CJK16x16" : "CJK32x32";
+	const struct font_desc *font = NULL;
+
+	fontdata = par ? par->fontbuffer : vc->vc_font.data;
+	src = fontdata + ch * cellsize;
+	if (ch != 0xff && ch != 0xfe)
+		return src;
+
+	/* assume current font not support unicode */
+	if (vc->vc_font.charcount < 65536) {
+		if (par)
+			fontdata = par->fontbuffer_utf;
+		else {
+			font = find_font(fontname);
+			fontdata = (font && font->data) ? (void *) font->data : NULL;
+		}
+	}
+	if (fontdata) {
+		c_utf = utf8_pos(vc, s);
+		offset = (size_t)c_utf * cellsize_utf * 2;
+		if (ch == 0xfe)
+			offset += cellsize_utf;
+		if (par && offset + cellsize_utf > par->fd_size_utf)
+			return src;
+		if (!par && !font &&
+		    offset + cellsize_utf > vc->vc_font.charcount * cellsize)
+			return src;
+		src = fontdata + offset;
+	}
+
+	return src;
+}
+#endif
